                claims: "{\"exp\":200,\"sub\":\"independent-reference\"}",
            },
        ],
    )
}

#[test]
fn pem_keys_verify_independent_signatures_and_deterministic_signing_matches_reference() -> () {
    for vector in pem_references() {
        let policy = Validation { now: Option::Some(100), ..Validation::new(vector.algorithm) };
        let private = testing::expect_ok(
            Key::private_pem(vector.algorithm, vector.private, "reference"),
            "PKCS8",
        );
        let public = testing::expect_ok(
            Key::public_pem(vector.algorithm, vector.public, "reference"),
            "PKIX",
        );
        for key in[private, public] {
            let result = testing::expect_ok(
                jwt::verify(vector.token, Vec::from_array([key]), policy),
                "independent signature",
            );
            testing::assert_eq(result.claims_json(), vector.claims);
        }
        let signed = testing::expect_ok(
            jwt::sign_json(private, vector.claims, SignOptions::new()),
            "private signing",
        );
        if vector.algorithm != Algorithm::ES256 {
            testing::assert_eq(signed, vector.token);
        }
        testing::assert_ok(jwt::verify(signed, Vec::from_array([public]), policy));
        if vector.alternate != "" {
            let alternative = testing::expect_ok(
                Key::private_pem(vector.algorithm, vector.alternate, "reference"),
                "PKCS1 or SEC1",
            );
            testing::assert_ok(jwt::verify(vector.token, Vec::from_array([alternative]), policy));
        }
        if vector.public_alternate != "" {
            let alternative = testing::expect_ok(
                Key::public_pem(vector.algorithm, vector.public_alternate, "reference"),
                "PKCS1 public",
            );
            testing::assert_ok(jwt::verify(vector.token, Vec::from_array([alternative]), policy));
        }
        for algorithm in[Algorithm::HS256, Algorithm::RS256, Algorithm::ES256, Algorithm::EdDSA] {
            if algorithm != vector.algorithm {
                testing::assert(Key::public_pem(algorithm, vector.public, "").is_err());
                testing::assert(Key::private_pem(algorithm, vector.private, "").is_err());
            }
        }
        testing::assert(Key::public_pem(vector.algorithm, vector.private, "").is_err());
        testing::assert(
            Key::public_pem(vector.algorithm, vector.public + vector.public, "").is_err(),
        );
        testing::assert(
            Key::private_pem(vector.algorithm, vector.private + vector.private, "").is_err(),
        );
        testing::assert(jwt::sign_json(public, vector.claims, SignOptions::new()).is_err());
        for pem in[
            vector.public,
            " \t\n" + vector.public + " \t\n",
            vector.public.replace("\n", "\r\n"),
        ] {
            testing::assert_ok(Key::public_pem(vector.algorithm, pem, ""));
        }
        for pem in[
            vector.private,
            " \t\n" + vector.private + " \t\n",
            vector.private.replace("\n", "\r\n"),
        ] {
            testing::assert_ok(Key::private_pem(vector.algorithm, pem, ""));
        }
    }
}

#[test]
fn shared_keys_support_concurrent_signing_and_verification() -> () {
    let shared = key("shared");
    task::scope(
        |scope| {
            let tasks = Vec::new();
            for _ in 0..8 {
                tasks.push(
                    scope.spawn(
                        |_| {
                            for _ in 0..20 {
                                let token = testing::expect_ok(
                                    jwt::sign_json(shared, "{\"exp\":200}", SignOptions::new()),
                                    "shared signing",
                                );
                                let policy = Validation {
                                    now: Option::Some(100),
                                    ..Validation::new(Algorithm::HS256),
                                };
                                testing::assert_ok(
                                    jwt::verify(token, Vec::from_array([shared]), policy),
                                );
                            }
                        },
                    ),
                );
            }
            let _ = task::join_all(tasks);
        },
    );
}
