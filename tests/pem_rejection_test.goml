    let pem = "-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA/PG7VIZNDQGg5DQjhVSiG2KY+Vz7Er3Nxi2ubRCGtsAviMVX\nYIE/SNcCmcD9QBvsxlhQAOg2qWqnwuOV8ItfXB7Nddt4d4GlSqkSs5OM6E3DbMHv\nFptsHPg1gCHK7U+cd1jFzogyKKWPN4dtu7SzDJdisF87rQicC5Wy1ROieC9XT6R6\nRVpNaIf9c6ARXQlOcd5EXS2w+jy7060nWL45seDa513kI2xtaU3voxxBCG4S3dOd\nwucKXv80xRYvDXGLg8FZUWOTseLskxR0ouYrOMrdh1s6LQuVuDbRH+IJbuSAtM9e\nEW2m0lWKlUPoB43AX43h7G9ijeAnEYzzHn2UHQIDAQABAoIBAFBnBoT3q8ZWni3r\n5N6c6GqMDNQ3Ghf6/U3hd3BzsF6m+HUhRYUHkHY24jy9e8LFHZ5us/+V0MpJfMoW\nTbMImmdN40FzYfea3k+9LpSmckPldBk+DCHDhbovq9Hu6/JDPBkzvqzH3inNdpjQ\nE7F23vNBq70kiHOYKQIFs7LHav2IbRHsBKoY2BT/22SzcnZhTlYuOa2m5DL/kOp1\nzWE8/feHwmn5cMradQi83mBL8FgI6quIb/8jVPJEjnjZ/EtcPmbvyVKGhITlMjok\nsvVg+o8XB9ebv44U/cdVjJluqcX63KWABjq4w+6yXiMi4bpwR+cuobTTABJNVSnH\nQhs2moECgYEA/nexEVmMf7AvpHLwIypEhqK8s4KK8FE/xK80N+gUmS6hbFwdSCmh\nX2Lx1jbAXBFuEvEnxWV2JkgdrnTG7mZTQZvXugPUQIlAjt5v/yv4GT97tN4zLF0u\nBtoFqF81bDVznJDjreL4HLRV8sZ/UW0OCbnc6Hxh1mfjQAZwFduULpMCgYEA/nex\nEVmMf7AvpHLwIypEhqK8s4KK8FE/xK80N+gUmS6hbFwdSCmhX2Lx1jbAXBFuEvEn\nxWV2JkgdrnTG7mZTQZvXugPUQIlAjt5v/yv4GT97tN4zLF0uBtoFqF81bDVznJDj\nreL4HLRV8sZ/UW0OCbnc6Hxh1mfjQAZwFduUMI8CgYBSdI5XxOCV741AiE3v1x5l\nUg47TK2guXMkVHFjPDyQdl+wMRj77SFxOyqJ8yvZqXw1fxcYC4yBUxTrFsPvNBD+\nTXVVvS/lyZO1t7YqxSCbbcq0DNwgIAFuDu+OY2t4KMnRjdF44vbqtjSzekZ/KAtI\nc4V1f/hj9T3Z3TwsmP4nKQKBgQDXyHuYcM1ZgfgEhYro5vDRErLdrjdPbjaa/M9V\nETJWa1prXvldth+nmWnl8uvPpuAmo+TL2SwFbmXtCA2hH5g+LH8UuCaGy1y5ShrC\n0XBDSLgIOdw/JIzhNoRRsNrGddUh0SOg0rT+8lVn17cjP00GJlwTsVXt0I6+PjdR\n8a+KNQKBgQCCvX7A2dnSvMndDrTTlDRXUJZePojlTAMH0vYKlPhw+DW1J0N0MZv7\nFhyAtFGyU4mwB/7Dp4fKF/MHfYJtYe1LiQN/UZbgp0X0vd/XQm7Wi/R4pI4ygoUA\nfyImocxUUeM1u1K1j1Ie360ql16kSq0B+TF/gmy5PnI8nIElb02lCA==\n-----END RSA PRIVATE KEY-----\n";
    testing::assert_eq(
        testing::expect_err(Key::private_pem(Algorithm::RS256, pem, ""), "close RSA primes").kind,
        ErrorKind::Key,
    );
}

#[test]
fn pkcs8_rejects_invalid_nested_sec1_explicit_parameters() -> () {
    let fixture = pem_references()[2];
    let block = testing::expect_some(
        testing::expect_ok(pem::decode(fixture.private, 65536, 65536, 0), "P256 PKCS8"),
        "P256 block",
    ).0;
    let limits = asn1::Limits::standard();
    let outer = testing::expect_ok(asn1::parse_tlv(block.data().as_slice(), limits), "PKCS8 outer");
    let fields = testing::expect_ok(
        asn1::split_tlvs(outer.content.as_slice(), limits),
        "PKCS8 fields",
    );
    let inner = testing::expect_ok(
        asn1::parse_tlv(fields[2].content.as_slice(), limits),
        "SEC1 inner",
    );
    let inner_fields = testing::expect_ok(
        asn1::split_tlvs(inner.content.as_slice(), limits),
        "SEC1 fields",
    );
    for explicit in[Vec::from_array([160, 3, 6, 1, 128]), Vec::from_array([161, 4, 3, 2, 7, 1])] {
        let body = Vec::new();
        for index in 0..2 {
            body.extend(
                testing::expect_ok(
                    asn1::encode_tlv(
                        inner_fields[index].tag,
                        inner_fields[index].content.as_slice(),
                        limits,
                    ),
                    "SEC1 required field",
                ),
            );
        }
        body.extend(explicit);
        let ec = testing::expect_ok(asn1::encode_tlv(48, body.as_slice(), limits), "SEC1 wrapper");
        let pkcs8_body = Vec::new();
        for index in 0..2 {
            pkcs8_body.extend(
                testing::expect_ok(
                    asn1::encode_tlv(fields[index].tag, fields[index].content.as_slice(), limits),
                    "PKCS8 required field",
                ),
            );
        }
        pkcs8_body.extend(
            testing::expect_ok(asn1::encode_tlv(4, ec.as_slice(), limits), "PKCS8 octets"),
        );
        let encoded = testing::expect_ok(
            asn1::encode_tlv(48, pkcs8_body.as_slice(), limits),
            "PKCS8 wrapper",
        );
        testing::assert_eq(
            testing::expect_err(
                Key::private_pem(Algorithm::ES256, wrap_pem("PRIVATE KEY", encoded), ""),
                "invalid inner SEC1",
            ).kind,
            ErrorKind::Key,
        );
    }
}
