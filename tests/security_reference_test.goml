package tests;

use ecosystem::jwt;
use ecosystem::jwt::{Algorithm, Key, SignOptions, Validation, ErrorKind};
use std::testing;

#[test]
fn independently_signed_malformed_tokens_fail_closed() -> () {
    let policy = Validation { now: Option::Some(100), ..Validation::new(Algorithm::HS256) };
    for token in[
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMCwiZXhwIjozMDB9.2djrPjXcHiUl_-Tv85pT85E7cV6RpE287GMyYy2nVIw",
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMCwiXHUwMDY1eHAiOjMwMH0.qV9RTsIqVFRBcuCQNl5rU2i8D9lrU5r6cYH20DJK-10",
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMCwiZGF0YSI6eyJhIjoxLCJcdTAwNjEiOjJ9fQ.xD5zvZdSZJODljzhbBxJHedBXIZ-QJ0ugToa3_Bg738",
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMH0ge30.wqZlvhiMV2O-mhKlOAQfNuvLqVtvWWYXa_qOegJPjnw",
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMCwieCI6Ilx1ZDgwMCJ9.4DbfftEXxyqxf1y77WWfKCd_dlZYfGRzsuopNNGi7dQ",
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMCwieCI6Ilx1ZGMwMCJ9.If9tTU29PeGzpymfv9uf3SrnmEKnZdhv4NyOKCDWv_I",
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMCwieCI6Ilx1ZDgwMFx1MDA0MSJ9.z_uOkplFz_5unsRGcMt_ahHaUPAoqXBVvp5-71cjY9E",
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMCwieCI6Iv8ifQ.66DQrS9e_JDEaNmOc_trUcfcFuzg-EyQKgeXMG5wqcs",
        "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOiIyMDAifQ.nd888O-Gh4x_qZDzFS3o5VizjKQHdUDUfCvCSUXnh5w",
