#[test]
fn independently_signed_numeric_dates_preserve_exact_boundaries() -> () {
    let cases: Vec[(string, i64, i64, Option[ErrorKind])] = Vec::from_array(
        [
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjEwMH0.2rWo9-C7W5ttBPP-dqMxhQ1I7780K0LNTZySVyMsAJ0",
                100,
                0,
                Option::Some(ErrorKind::Expired),
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjEwMH0.2rWo9-C7W5ttBPP-dqMxhQ1I7780K0LNTZySVyMsAJ0",
                100,
                1,
                Option::None,
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjEwMC4wMDAwMDAwMDAwMDAwMDAwMDF9.jUdaNy69TxAqEW4lzhKhn9DZFz_TCes0EYSb8vjTmUA",
                100,
                0,
                Option::None,
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjFlMn0.ABRKXliJNvqSMcfovWyiWZwXzcfx5tJGuQNHdXOU1po",
                100,
                0,
                Option::Some(ErrorKind::Expired),
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMCwibmJmIjoxMDF9.pMHOMtaEy6ihpD8oyBAgF-BMIzT3a4KoEr2OdlQzVW8",
                100,
                0,
                Option::Some(ErrorKind::NotYetValid),
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMCwibmJmIjoxMDF9.pMHOMtaEy6ihpD8oyBAgF-BMIzT3a4KoEr2OdlQzVW8",
                100,
                1,
                Option::None,
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMCwiaWF0IjoxMDF9.-5wKpdOG53uiyWxw3x1x54hVYaeEmURi7qlbxR-M4LA",
                100,
                0,
                Option::Some(ErrorKind::IssuedAt),
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMCwiaWF0IjoxMDB9.67a1HQ1SJPPjniGbA_IqtcgANTCmVcF5lyOMYTSKEmk",
                100,
                0,
                Option::None,
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.svo3sQiBr6VRrugrrB1OoHS7Y-c0pzdPFYhCfjX7elM",
                100,
                0,
                Option::Some(ErrorKind::Claims),
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjI1MzQwMjMwMDc5OX0.C8h3ke9JgvTEC2ZK4UdE8q1-FhKzWK0QYt23halTHgY",
                253402300798,
                0,
                Option::None,
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjI1MzQwMjMwMDc5OS4wMDAwMDAwMDAxfQ.UDierMa6t8u2s_prdVUIKtGa1kMKROc32J76eDydU4Q",
                0,
                0,
                Option::Some(ErrorKind::Claims),
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOi0yNTM0MDIzMDA3OTkuMDAwMDAwMDAwMX0.bLwa_qMIXXB0slGRwU4ca9h2XMyHVfQcPJjtSt-VEOc",
                0,
                0,
                Option::Some(ErrorKind::Claims),
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjFlLTEwMH0.vT61F-QdmdH2TlPR6sHsUv5NVLz-dOdoXlrIaBITFk0",
                0,
                0,
                Option::None,
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjFlLTEwMX0.wEhKr9MsVQh8pgZX8qYQYscF6dxkHrTk0tvJkYGNZ84",
                0,
                0,
                Option::Some(ErrorKind::Claims),
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjBlMTAwfQ.qxQKFRWptOonqWWaUke6u1CacCRROYfe2Sf6ZamUwoI",
                -1,
                0,
                Option::None,
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjBlMTAxfQ.FLSLIqdvlaA6cOq4E6gBNMxrheq6WIRAUIQPbcUm3Co",
                -1,
                0,
                Option::Some(ErrorKind::Claims),
            ),
            (
                "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOi0wLjAwMDAwMDAwMDAxfQ.gebXL1F8kSbQkze_B5TCTfMaD3E24ZLJA2TbceYQhsk",
                0,
                0,
                Option::Some(ErrorKind::Expired),
            ),
        ],
    );
    for (token, now, leeway, expected) in cases {
        let policy = Validation {
            now: Option::Some(now),
            leeway_seconds: leeway,
            ..Validation::new(Algorithm::HS256),
        };
        match expected {
            Option::None => testing::assert_ok(
                jwt::verify(token, Vec::from_array([key("")]), policy),
            ),
            Option::Some(kind) => testing::assert_eq(
                testing::expect_err(
                    jwt::verify(token, Vec::from_array([key("")]), policy),
                    "date rejection",
                ).kind,
                kind,
            ),
        }
    }
}

#[test]
fn secret_snapshot_and_limits_are_preserved() -> () {
    let secret = "0123456789abcdef0123456789abcdef".to_bytes();
    let active = testing::expect_ok(Key::hmac(secret, "v2"), "secret snapshot");
    secret[0] = 0;
    let token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCIsImtpZCI6InYyIn0.eyJleHAiOjIwMH0.DYCVDYEb0gqPqzi8zQCwJ3aFJBmp9tCvUwfuNwH1wbk";
    let policy = Validation { now: Option::Some(100), ..Validation::new(Algorithm::HS256) };
    testing::assert_ok(jwt::verify(token, Vec::from_array([key("v1"), active]), policy));
    testing::assert(jwt::verify(token, Vec::from_array([active, active]), policy).is_err());
    testing::assert(
        jwt::verify(
            "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwMH0.wXGqYfd2zHQhC5mBf-AU8qP-HUmiv52QZ25qW2Whz60",
            Vec::from_array([key("v1"), active]),
            policy,
        ).is_err(),
    );
    for limit in[0, 255, 1048577] {
        testing::assert(
            jwt::verify(
                token,
                Vec::from_array([active]),
                Validation { max_token_bytes: limit, ..policy },
            ).is_err(),
        );
    }
    for leeway in[-1, 86401] {
        testing::assert(
            jwt::verify(
                token,
                Vec::from_array([active]),
                Validation { leeway_seconds: leeway, ..policy },
            ).is_err(),
        );
    }
    for now in[-253402300800, 253402300800] {
        testing::assert(
            jwt::verify(
                token,
                Vec::from_array([active]),
                Validation { now: Option::Some(now), ..policy },
            ).is_err(),
        );
    }
    testing::assert(
        Key::hmac("-----BEGIN PUBLIC KEY----- long enough secret".to_bytes(), "").is_err(),
    );
    testing::assert(
        jwt::verify(
            token,
            Vec::from_array([active]),
            Validation {
                algorithms: Vec::from_array([Algorithm::HS256, Algorithm::HS256]),
                ..policy,
            },
        ).is_err(),
    );
}

#[test]
fn rfc8037_signature_authenticates_before_non_json_payload_is_rejected() -> () {
    let public = testing::expect_ok(
        Key::public_jwk(Algorithm::EdDSA, ed_jwk("")),
        "RFC8037 public key",
    );
    let token = "eyJhbGciOiJFZERTQSJ9.RXhhbXBsZSBvZiBFZDI1NTE5IHNpZ25pbmc.hgyY0il_MGCjP0JzlnLWG1PPOt7-09PGcvMg3AIbQR6dWbhijcNR4ki4iylGjg5BhVsPt9g7sVvpAr_MuM0KAg";
    let policy = Validation {
        token_type: "",
        require_expiration: false,
        now: Option::Some(0),
        ..Validation::new(Algorithm::EdDSA),
    };
    testing::assert_eq(
        testing::expect_err(
            jwt::verify(token, Vec::from_array([public]), policy),
            "non-JSON RFC payload",
        ).kind,
        ErrorKind::Json,
    );
    let corrupted = token.byte_slice(0, token.byte_len() - 2) + "AA";
    testing::assert_eq(
        testing::expect_err(
            jwt::verify(corrupted, Vec::from_array([public]), policy),
            "authentication precedes JSON",
        ).kind,
        ErrorKind::Signature,
    );
}

#[test]
fn malformed_compact_token_mutation_corpus_is_recoverable() -> () {
    let policy = Validation { now: Option::Some(100), ..Validation::new(Algorithm::HS256) };
    let keys = Vec::from_array([key("")]);
    for input in["..", ".", "a.b.c", "A.A.A", "{}.{}.{}", "null.null.null", "a".repeat(1048577)] {
        testing::assert(jwt::verify(input, keys, policy).is_err());
    }
    for length in 0..256 {
        testing::assert(
            jwt::verify("A".repeat(length) + "." + "Z".repeat(255 - length) + ".AA", keys, policy).is_err(),
        );
    }
}

#[test]
fn claim_switches_keep_type_validation_and_json_complexity_boundaries() -> () {
    let active = key("");
    let policy = Validation {
        now: Option::Some(100),
        require_expiration: false,
        check_issued_at: false,
        ..Validation::new(Algorithm::HS256),
    };
    let token = testing::expect_ok(
        jwt::sign_json(active, "{\"iat\":101}", SignOptions::new()),
        "future issuance",
    );
    testing::assert_ok(jwt::verify(token, Vec::from_array([active]), policy));
    testing::assert_eq(
        testing::expect_err(
            jwt::verify(
                token,
                Vec::from_array([active]),
                Validation { check_issued_at: true, ..policy },
            ),
            "future issuance enabled",
        ).kind,
        ErrorKind::IssuedAt,
    );
    for claims in["{\"iat\":null}", "{\"nbf\":null}", "{\"exp\":null}"] {
        testing::assert_eq(
            testing::expect_err(
                jwt::sign_json(active, claims, SignOptions::new()),
                "registered type",
            ).kind,
            ErrorKind::Claims,
        );
    }
    let depth_limit = "{\"exp\":200,\"x\":" + "[".repeat(63) + "0" + "]".repeat(63) + "}";
    testing::assert_ok(jwt::sign_json(active, depth_limit, SignOptions::new()));
    let too_deep = "{\"exp\":200,\"x\":" + "[".repeat(64) + "0" + "]".repeat(64) + "}";
    testing::assert_eq(
        testing::expect_err(jwt::sign_json(active, too_deep, SignOptions::new()), "JSON depth").kind,
        ErrorKind::Json,
    );
    let node_limit = "{\"exp\":200,\"x\":[" + "0,".repeat(16380) + "0]}";
    testing::assert_ok(jwt::sign_json(active, node_limit, SignOptions::new()));
    let too_many = "{\"exp\":200,\"x\":[" + "0,".repeat(16381) + "0]}";
    testing::assert_eq(
        testing::expect_err(jwt::sign_json(active, too_many, SignOptions::new()), "JSON values").kind,
        ErrorKind::Json,
    );
}
