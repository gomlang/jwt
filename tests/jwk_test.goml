                "{\"e\":\"AQAB\",\"kid\":\"RS256\",\"kty\":\"RSA\",\"n\":\"uB7H33am-jOFcG65_MKcQVT6RA-z07Ao7DeprTm-Pjh65eVdvJAqcsaq8E_C-tF48gI449sitDvhlluM6Qssz_tkDKOvDMxcONBMWQm3YFAScCioywhz8oHyPHz59FSVnzVWhGYOwN3fhXqr95D9xirmfw1lo4-u1WmZ2szyefkHknJrU_hl6RZZCOrvys4WEAX4kGRxhjXkQDD5k-tUENTTn0G4dLXv1fdZBwczT1dePuORNryhgLap0BZzubC97_Gd-Che7iPgPjMkywdAE1Wgus9IBsAhmo66Pd-_ETIgkIfyYS6oFPx0CwkS8D3bNsAZi2RwqPkqiuAuIGLqdQ\"}",
                "eyJhbGciOiJSUzI1NiIsImtpZCI6IlJTMjU2IiwidHlwIjoiSldUIn0.eyJleHAiOjIwMCwic3ViIjoicHVibGljLWp3ayJ9.dVYR_UVKcj7PquVGwWNwzKag3J_X1OaCKyZGTi5tgtUjhuUNG-RPQrpdLiVoIoXeStcX5JRt6vIDyQ2wJUirGjkUdlYnJ3X8LTzIpxuFUNbZ9TYhEedHU5b3kz7VH5Z1P_zPB-rFTgFNABGQB7YQKBWK--4QjAFneq2Fa98XYUMxfToIV97EUmLIt3cnkMEToHJHKtp7XoQ2hId66P_EPXVdb8P4uipG4v1zbE1czCEhjnGQVA3_LMVvSTHwpP9SiUPhiWeAx_lo922HlPqchHW3AHAIJ39TsyZIq9XdaDiqLJUqdZLXSKolAJ4aslOCIpeYyqfSSXwAoPKQJ2kymA",
            ),
            (
                Algorithm::ES256,
                "{\"crv\":\"P-256\",\"kid\":\"ES256\",\"kty\":\"EC\",\"x\":\"axfR8uEsQkf4vOblY6RA8ncDfYEt6zOg9KE5RdiYwpY\",\"y\":\"T-NC4v4af5uO5-tKfA-eFivOM1drMV7Oy7ZAaDe_UfU\"}",
                "eyJhbGciOiJFUzI1NiIsImtpZCI6IkVTMjU2IiwidHlwIjoiSldUIn0.eyJleHAiOjIwMCwic3ViIjoicHVibGljLWp3ayJ9.zzbnaYYGKJf0OSJEHwW_oXScNYCUq-5GChMXs1nzoY-wfQ7RbMMv_y93jhUSVwIhB5gFFtTJk81zazt3BOf1HA",
            ),
            (
                Algorithm::EdDSA,
                "{\"crv\":\"Ed25519\",\"kid\":\"EdDSA\",\"kty\":\"OKP\",\"x\":\"O2onvM62pC1io6jQKm8Nc2UyFXcd4kOmOsBIoYtZ2ik\"}",
                "eyJhbGciOiJFZERTQSIsImtpZCI6IkVkRFNBIiwidHlwIjoiSldUIn0.eyJleHAiOjIwMCwic3ViIjoicHVibGljLWp3ayJ9.U29a11N2WdTm88CLEs01X5pKvvcsOPl4sZb92tPuasVkm-LENfml-6urAluPj3n3NKvATfpiuumdPa4JNoJaCg",
            ),
