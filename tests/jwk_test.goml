}

#[test]
fn public_jwk_verifies_independent_rsa_ec_and_ed25519_tokens() -> () {
    for (algorithm, input, token) in jwk_vectors() {
        let key = testing::expect_ok(Key::public_jwk(algorithm, input), "public JWK");
        testing::assert_eq(key.algorithm(), algorithm.to_string());
        testing::assert_eq(key.key_id(), algorithm.to_string());
        let policy = Validation { now: Option::Some(100), ..Validation::new(algorithm) };
        let verified = testing::expect_ok(
            jwt::verify(token, Vec::from_array([key]), policy),
            "independent token",
        );
        testing::assert_eq(verified.claims_json(), "{\"exp\":200,\"sub\":\"public-jwk\"}");
        testing::assert_eq(verified.key_id(), algorithm.to_string());
        testing::assert_eq(
            testing::expect_err(
                jwt::sign_json(key, "{\"exp\":200}", SignOptions::new()),
                "public signing",
            ).kind,
            ErrorKind::Key,
        );
    }
}

#[test]
fn public_jwks_preserves_order_and_verifies_mixed_algorithm_rotation() -> () {
    let document = "{\"keys\":[";
    let first = true;
    for (_, input, _) in jwk_vectors() {
        if !first {
            document += ",";
        }
        document += input;
        first = false;
    }
    document += "]}";
    let keys = testing::expect_ok(
        jwt::public_jwks(
            document,
            Vec::from_array([Algorithm::EdDSA, Algorithm::RS256, Algorithm::ES256]),
        ),
        "mixed JWK set",
    );
    testing::assert_eq(keys.len(), 3);
    testing::assert_eq(keys[0].algorithm(), "RS256");
    testing::assert_eq(keys[1].algorithm(), "ES256");
    testing::assert_eq(keys[2].algorithm(), "EdDSA");
    for (algorithm, _, token) in jwk_vectors() {
        let policy = Validation { now: Option::Some(100), ..Validation::new(algorithm) };
        testing::assert_eq(
            testing::expect_ok(jwt::verify(token, keys, policy), "rotation").key_id(),
            algorithm.to_string(),
        );
    }
    testing::assert_eq(
        testing::expect_err(
            jwt::public_jwks(document, Vec::from_array([Algorithm::EdDSA])),
            "disallowed member",
        ).kind,
        ErrorKind::Algorithm,
    );
}

fn ed_jwk(extra: string) -> string {
    "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\""
        + extra
        + "}"
}

#[test]
fn public_jwk_rejects_conflicting_policy_private_material_and_bad_encoding() -> () {
    for extra in[
        ",\"use\":\"enc\"",
        ",\"use\":null",
        ",\"key_ops\":[\"sign\"]",
        ",\"key_ops\":[\"verify\",\"verify\"]",
        ",\"key_ops\":[\"sign\",\"verify\"]",
        ",\"key_ops\":[]",
        ",\"kid\":null",
        ",\"kid\":\"\"",
        ",\"d\":null",
        ",\"p\":null",
        ",\"q\":null",
        ",\"dp\":null",
        ",\"dq\":null",
        ",\"qi\":null",
        ",\"oth\":null",
        ",\"k\":null",
        ",\"n\":null",
        ",\"y\":null",
    ] {
        testing::assert_eq(
            testing::expect_err(
                Key::public_jwk(Algorithm::EdDSA, ed_jwk(extra)),
                "invalid public key",
            ).kind,
            ErrorKind::Key,
        );
    }
    testing::assert_eq(
        testing::expect_err(
            Key::public_jwk(Algorithm::EdDSA, ed_jwk(",\"alg\":\"HS256\"")),
            "conflicting alg",
        ).kind,
        ErrorKind::Algorithm,
    );
    testing::assert_eq(
        testing::expect_err(Key::public_jwk(Algorithm::HS256, ed_jwk("")), "symmetric policy").kind,
        ErrorKind::Algorithm,
    );
    for input in[
        "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURp\"}",
        "{\"kty\":\"OKP\",\"crv\":\"Ed25519\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo=\"}",
        "{\"kty\":\"OKP\",\"crv\":\"X25519\",\"x\":\"11qYAYKxCrfVS_7TyWQHOg7hcvPapiMlrwIaaPcHURo\"}",
        "{\"kty\":\"OKP\",\"crv\":\"Ed25519\"}",
    ] {
        testing::assert_eq(
            testing::expect_err(Key::public_jwk(Algorithm::EdDSA, input), "invalid key parameters").kind,
            ErrorKind::Key,
        );
    }
    testing::assert_ok(
        Key::public_jwk(
            Algorithm::EdDSA,
            ed_jwk(",\"use\":\"sig\",\"key_ops\":[\"verify\"],\"x5u\":\"https://unused.invalid\""),
        ),
    );
}

#[test]
fn public_jwk_and_jwks_reject_duplicate_members_and_ambiguous_ids() -> () {
    for extra in[",\"kty\":\"OKP\"", ",\"\\u006bty\":\"OKP\"", ",\"extra\":{\"a\":1,\"\\u0061\":2}"] {
        testing::assert_eq(
            testing::expect_err(
                Key::public_jwk(Algorithm::EdDSA, ed_jwk(extra)),
                "duplicate member",
            ).kind,
            ErrorKind::Json,
        );
    }
    let key = ed_jwk(",\"kid\":\"active\"");
    for document in[
        "{\"keys\":[" + key + "," + key + "]}",
        "{\"keys\":[" + ed_jwk("") + "]}",
        "{\"keys\":[" + key + ",null]}",
    ] {
        testing::assert_eq(
            testing::expect_err(
                jwt::public_jwks(document, Vec::from_array([Algorithm::EdDSA])),
                "invalid set",
            ).kind,
            ErrorKind::Key,
        );
    }
    testing::assert_eq(
        testing::expect_err(
            jwt::public_jwks("{\"keys\":[],\"\\u006beys\":[]}", Vec::from_array([Algorithm::EdDSA])),
            "duplicate set member",
        ).kind,
        ErrorKind::Json,
    );
    testing::assert_eq(
        testing::expect_err(
            jwt::public_jwks("{\"keys\":[]}", Vec::from_array([Algorithm::EdDSA])),
            "empty set",
        ).kind,
        ErrorKind::Limit,
    );
    testing::assert_eq(
        testing::expect_err(
            jwt::public_jwks(
                "{\"keys\":[" + key + "]}",
                Vec::from_array([Algorithm::EdDSA, Algorithm::EdDSA]),
            ),
            "duplicate allowlist",
        ).kind,
        ErrorKind::Algorithm,
    );
}

#[test]
fn public_jwks_enforces_the_64_key_bound() -> () {
    let document = "{\"keys\":[";
    let i = 0;
    while i < 64 {
        if i > 0 {
            document += ",";
        }
        document += ed_jwk(",\"kid\":\"" + i.to_string() + "\"");
        i += 1;
    }
    let keys = testing::expect_ok(
        jwt::public_jwks(document + "]}", Vec::from_array([Algorithm::EdDSA])),
        "maximum set",
    );
    testing::assert_eq(keys.len(), 64);
    testing::assert_eq(keys[63].key_id(), "63");
    testing::assert_eq(
        testing::expect_err(
            jwt::public_jwks(
                document + "," + ed_jwk(",\"kid\":\"64\"") + "]}",
                Vec::from_array([Algorithm::EdDSA]),
            ),
            "oversized set",
        ).kind,
        ErrorKind::Limit,
    );
}
